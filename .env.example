# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# --- Scraper politeness ---
SCRAPER_USER_AGENT=P6-portfolio-scraper/0.1 (+educational project; practice sites only)
SCRAPER_DELAY_SECONDS=1.0
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_MAX_RETRIES=3
SCRAPER_BACKOFF_SECONDS=1.0

# --- PostgreSQL (dedicated P6 container on port 5435) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=scraper
POSTGRES_USER=scraper
POSTGRES_PASSWORD=change-me

# --- Output ---
OUTPUT_DIR=outputs
REPORT_TIMEZONE=Africa/Cairo
